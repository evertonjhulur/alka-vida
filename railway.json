{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm install --include=dev && npm run build -w @alka/web",
    "watchPatterns": ["/**"]
  },
  "deploy": {
    "startCommand": "npm run start:railway -w @alka/api",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
