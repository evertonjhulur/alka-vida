{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci --include=dev && npm run build -w @alka/web"
  },
  "deploy": {
    "startCommand": "npm start -w @alka/api",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
